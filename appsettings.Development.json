{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MiPeluqueriaDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=false;Pooling=true;Min Pool Size=1;Max Pool Size=100;Connect Timeout=30"
  },
  "Jwt": {
    "Key": "MiPeluqueria_Super_Secret_Key_Tesis_Cervantes_Edu_2026_Segura!",
    "Issuer": "MiPeluqueriaApi",
    "Audience": "MiPeluqueriaFrontend",
    "AccessTokenExpirationHours": 8,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:3000"
    ]
  },
  "RateLimiting": {
    "StrictAuthOtpPolicy": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "FromEmail": "no-reply@mipeluqueria.com",
    "FromName": "Mi Peluquería SaaS",
    "TimeoutMilliseconds": 5000
  },
  "Payments": {
    "MercadoPago": {
      "AccessToken": "",
      "WebhookSecret": "mp_webhook_secret_dev_2026"
    },
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "whsec_stripe_secret_dev_2026"
    }
  },
  "BackgroundJobs": {
    "RecordatoriosIntervaloMinutos": 15,
    "CancelarReservasOnlineImpagas": true,
    "MinutosExpiracionSenaOnline": 30
  },
  "SaaSLimits": {
    "MaxPeluquerosSeguridadPorSucursal": 50,
    "MaxSucursalesSeguridadPorTenant": 20
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "restrictedToMinimumLevel": "Information",
          "shared": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/errors-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "restrictedToMinimumLevel": "Warning",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "shared": true
        }
      }
    ]
  }
}